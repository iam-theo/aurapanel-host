# ServerPanel — copy to backend/.env and edit ( installer does this automatically )
# See ENTERPRISE.md for vault / TLS notes. This file is chmod 600.

PORT=3500
PANEL_USER=panel
PANEL_HOME=/home/panel
PANEL_APPS_DIR=/home/panel/apps
PANEL_BACKUP_DIR=/home/panel/backups
PANEL_COMPOSE_DIR=/home/panel/compose
# where panel-users.json lives (relative to backend/)
PANEL_DATA_DIR=data

# secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-32-byte-hex
# sudo password for panel user if not using NOPASSWD sudoers (not recommended for prod)
SUDO_PASSWORD=

# first admin — created on first boot if no users exist
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=change-me

# backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_COUNT=50
# 32-byte hex to enable encrypted backups (aes-256-gcm)
BACKUP_ENCRYPTION_KEY=
# offsite hook, {file} and {dir} are replaced, e.g. rclone copy {file} s3:bucket/backups/
BACKUP_OFFSITE_HOOK=

# security
AUTH_DISABLED=false
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
NODE_ENV=production
